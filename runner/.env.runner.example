# Isi dari dashboard (Tambah runner menampilkan token sekali).
LUMBUNG_URL=https://lumbung.rumahsakit.co.id
LUMBUNG_RUNNER_TOKEN=
# Image runner. Update: ganti tag ini lalu `docker compose ... up -d` (lihat README).
RUNNER_IMAGE=zmutclik/lumbungdb-runner:r2
# Disk scratch terenkripsi, sebesar data terbesar yang diuji dikali beberapa.
SCRATCH_DIR=/srv/lumbung-scratch
# Kunci privat age milik runner (salah satu penerima enkripsi backup). Izin 600.
AGE_IDENTITY_FILE=/etc/lumbung/age-runner.key
# Image MariaDB yang sama dengan sumber, supaya versi tidak naik.
MARIADB_IMAGE=zmutclik/mariadb:lumbungdb-12.3-a2
