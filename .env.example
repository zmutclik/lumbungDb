# Salin ke .env dengan izin 600. Jangan commit.

# Mount NFS di VM ini. Harus berisi file penanda: touch <mount>/.lumbung-mounted
BACKUP_ROOT=/mnt/lumbungdb
# UID dan GID yang boleh menulis ke NFS dan ke folder config/
LUMBUNG_UID=1000
LUMBUNG_GID=1000

# Password database metadata LumbungDB (container db). Huruf dan angka saja, karena masuk ke URL koneksi.
DB_PASSWORD=
# Wajib ≥ 32 karakter: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Kunci publik age penerima backup, dipisah koma: kunci runner,kunci pemulihan. Buat di luar server ini
# dengan age-keygen. Kunci privatnya jangan pernah disimpan di server ini. Lihat README.
BACKUP_AGE_RECIPIENTS=

# Reverse proxy. Hanya dari sini X-Forwarded-* dipercaya; ganti APP_SUBNET bila bentrok dengan network lain.
APP_SUBNET=172.30.0.0/24
TRUSTED_PROXY_IPS=172.30.0.0/24
# nginx-tls.conf untuk produksi. Sertifikat full chain: <TLS_CERT_DIR>/fullchain.pem dan privkey.pem
NGINX_CONF=nginx-tls.conf
TLS_CERT_DIR=./deploy/certs
HTTP_PORT=80
HTTPS_PORT=443

# Notifikasi. Kosong berarti hanya masuk log.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Nilai contoh IMAGE_TAG di .env yang disediakan Tambah container
IMAGE_TAG_DEFAULT=12.3-a1

# Batas waktu perintah pasang di Tambah container, dalam jam
INSTALL_COMMAND_HOURS=2

# Batas terpanjang satu sesi Restore manual, termasuk perpanjangan, dalam jam
MANUAL_RESTORE_MAX_HOURS=24

# Lapisan AI (ringkasan laporan). Mati bila kosong atau none. Hanya angka teragregasi, temuan, dan pola query tanpa
# nilai literal yang dikirim. Penyedia: claude (AI_API_KEY wajib) | openai (API /chat/completions: gateway, vLLM, LiteLLM;
# AI_BASE_URL berakhir /v1) | ollama (AI_BASE_URL ke server Ollama) | fake
AI_PROVIDER=none
AI_MODEL=claude-haiku-5-5
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com

WEB_CONCURRENCY=2
DISPLAY_TIMEZONE=Asia/Jakarta
